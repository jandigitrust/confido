{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification-result-v2",
  "description": "Evidence-only appraisal result; application admission and observed TLS peer authentication are separate.",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        2
      ]
    },
    "scope": {
      "description": "Limits this result to evidence verification; it is not an application access grant.",
      "enum": [
        "evidence_only"
      ]
    },
    "status": {
      "description": "Overall evidence verdict after the ordered checks.",
      "enum": [
        "verified",
        "invalid_evidence",
        "policy_mismatch",
        "unsupported_profile",
        "incomplete_input"
      ]
    },
    "reason": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "azure-snp-vtpm-ima/1"
      ]
    },
    "wire_version": {
      "enum": [
        1
      ]
    },
    "evaluated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "expected_nonce_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "object",
      "properties": {
        "amd_chain_pem": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "vcek_der": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "amd_chain_pem",
        "vcek_der",
        "reference_json"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "reason": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "ima_matches": {
            "description": "Optional per-received-entry comparison with the pinned reference, in collector order. Only present on ima_reference after reference authentication. Does not imply overall verification success.",
            "type": "array",
            "maxItems": 16384,
            "items": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "stage",
          "status",
          "reason",
          "detail"
        ],
        "additionalProperties": false,
        "if": {
          "required": ["ima_matches"]
        },
        "then": {
          "properties": {
            "stage": {"const": "ima_reference"}
          }
        }
      }
    },
    "verified_claims": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "object",
          "properties": {
            "stage": {
              "enum": [
                "snp_signature"
              ]
            },
            "product": {
              "enum": [
                "Milan",
                "Genoa"
              ]
            },
            "reported_tcb": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "launch_measurement": {
              "type": "string",
              "pattern": "^[a-f0-9]{96}$"
            }
          },
          "required": [
            "stage",
            "product",
            "reported_tcb",
            "launch_measurement"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "verified_artifacts": {
      "type": "object",
      "properties": {
        "certificate_der_base64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "certificate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "vtpm_key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "challenge_matches": {
          "type": "boolean"
        },
        "certificate_bound": {
          "type": "boolean"
        },
        "ima_log_bound": {
          "type": "boolean"
        }
      },
      "required": [
        "challenge_matches",
        "certificate_bound",
        "ima_log_bound"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "description": "Confirmed measurement coverage only; unmeasured application, model, and GPU state is not implied.",
      "type": "object",
      "properties": {
        "ima_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "description": {
          "type": "string"
        },
        "pcr10_method": {
          "enum": [
            "enrolled_sha256",
            "template_digest_replay"
          ]
        }
      },
      "required": [
        "ima_entries",
        "description"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "status",
    "reason",
    "profile",
    "wire_version",
    "evaluated_at",
    "expected_nonce_base64",
    "report_sha256",
    "policy_sha256",
    "input_sha256",
    "reference",
    "checks",
    "verified_claims",
    "verified_artifacts",
    "bindings",
    "coverage",
    "limitations"
  ],
  "additionalProperties": false,
  "$comment": "Pipeline revision 2 is reported by build_info(), outside this deterministic result. Stages are endorsements, snp_signature, vcek_correspondence, platform_policy, hcl_key, quote_signature, quote_binding, quoted_pcrs, reference, ima_reference, boot_aggregate, pcr10. Early parse failures may use input/profile/evidence/snp_report/certificate. Legacy stage strings remain valid for archived results. Partial artifacts do not authorize admission."
}
