# Generated by Cargo
# will have compiled files and executables
debug/
target/


# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

**/*.pem
**/.venv
__pycache__/
*.py[cod]

**/*.log

# Private, generated demonstration evidence and frozen runtime archives
.artifacts/

# Generated verifier bindings and browser packages
**/dist/
**/pkg/
bindings/python/licenses/

# Local Python tooling and coverage output
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
.coverage
.coverage.*
htmlcov/

# Local configuration and private keys
.env
.env.*
!.env.example
*.key
*.p12
*.pfx
CLAUDE.local.md
.claude/settings.local.json
